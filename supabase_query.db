-- ============================================================
-- TrackTube — Supabase schema (users + playlists CRUD)
-- ------------------------------------------------------------
-- HOW TO USE:
--   1. Open your Supabase project -> SQL Editor -> New query
--   2. Copy the ENTIRE contents of this file and paste it
--   3. Click "Run"
--
-- HOW AUTH WORKS:
--   • Users register with a username + password.
--   • The app hashes the password with bcrypt and stores ONLY
--     the hash in `users.password_hash` (never the plain text).
--   • On login the app signs a JWT (secret = JWT_SECRET in .env).
--   • Every CRUD request sends `Authorization: Bearer <jwt>`.
--   • The database is reached server-side with the service_role
--     key, which bypasses RLS — so RLS is enabled to lock the
--     tables down for everyone else (anon/authenticated = 0 rows).
-- ============================================================

-- ---------- TABLES ----------

-- Users (self-made auth: username + bcrypt password hash, no email required)
create table if not exists public.users (
  id uuid primary key default gen_random_uuid(),
  username text not null unique,
  password_hash text not null,
  created_at timestamptz not null default now(),
  updated_at timestamptz
);

-- Playlists (one row per playlist a user is tracking)
create table if not exists public.playlists (
  id uuid primary key default gen_random_uuid(),
  user_id uuid not null references public.users (id) on delete cascade,
  title text not null,
  channel text,
  url text not null,
  total_videos integer not null default 0,
  total_seconds bigint not null default 0,
  added_at timestamptz not null default now(),
  updated_at timestamptz,
  is_currently_watching boolean not null default false,
  last_viewed_at timestamptz
);

-- Videos inside a playlist
create table if not exists public.playlist_videos (
  id uuid primary key default gen_random_uuid(),
  playlist_id uuid not null references public.playlists (id) on delete cascade,
  youtube_id text not null,
  title text not null,
  duration integer not null default 0,
  position integer not null default 0,
  unique (playlist_id, youtube_id)
);

-- Progress (which videos a user has marked as watched)
create table if not exists public.progress (
  playlist_id uuid not null references public.playlists (id) on delete cascade,
  video_id uuid not null references public.playlist_videos (id) on delete cascade,
  marked_at timestamptz not null default now(),
  primary key (playlist_id, video_id)
);

-- ---------- INDEXES ----------

create index if not exists idx_playlists_user
  on public.playlists (user_id);
create index if not exists idx_playlist_videos_playlist
  on public.playlist_videos (playlist_id);
create index if not exists idx_progress_playlist
  on public.progress (playlist_id);

-- Currently watching / last viewed indexes
create index if not exists idx_playlists_last_viewed
  on public.playlists (user_id, last_viewed_at desc);
create index if not exists idx_playlists_currently_watching
  on public.playlists (user_id) where is_currently_watching;

-- ---------- UPDATED_AT TRIGGER ----------

create or replace function public.set_updated_at()
returns trigger
language plpgsql
as $$
begin
  new.updated_at = now();
  return new;
end;
$$;

drop trigger if exists trg_users_updated_at on public.users;
create trigger trg_users_updated_at
  before update on public.users
  for each row execute function public.set_updated_at();

drop trigger if exists trg_playlists_updated_at on public.playlists;
create trigger trg_playlists_updated_at
  before update on public.playlists
  for each row execute function public.set_updated_at();

-- ---------- RPC FUNCTIONS (used by the CRUD API) ----------

-- Create a playlist + all its videos in a single transaction.
-- NOT security definer: anon callers are still blocked by RLS,
-- the server calls it with the service_role key (bypasses RLS).
create or replace function public.create_playlist(
  p_user_id uuid,
  p_url text,
  p_title text,
  p_channel text,
  p_videos jsonb
) returns public.playlists
language plpgsql
as $$
declare
  v_playlist public.playlists;
  v_video jsonb;
  v_idx int := 0;
begin
  insert into public.playlists (user_id, title, channel, url, total_videos, total_seconds)
  values (
    p_user_id,
    p_title,
    p_channel,
    p_url,
    (select count(*) from jsonb_array_elements(p_videos)),
    (select coalesce(sum(coalesce((v->>'duration')::int, 0)), 0)
       from jsonb_array_elements(p_videos) v)
  )
  returning * into v_playlist;

  for v_video in select * from jsonb_array_elements(p_videos)
  loop
    insert into public.playlist_videos (playlist_id, youtube_id, title, duration, position)
    values (
      v_playlist.id,
      v_video->>'youtubeId',
      coalesce(v_video->>'title', 'Untitled'),
      coalesce((v_video->>'duration')::int, 0),
      v_idx
    );
    v_idx := v_idx + 1;
  end loop;

  return v_playlist;
end;
$$;

-- Replace the marked-video set for a playlist in one transaction.
-- video ids are YouTube video ids (text), translated to DB uuids here.
-- Throws if the playlist doesn't belong to the user.
create or replace function public.set_progress(
  p_user_id uuid,
  p_playlist_id uuid,
  p_youtube_ids text[]
) returns void
language plpgsql
as $$
begin
  if not exists (
    select 1 from public.playlists
    where id = p_playlist_id and user_id = p_user_id
  ) then
    raise exception 'playlist not found';
  end if;

  delete from public.progress where playlist_id = p_playlist_id;

  insert into public.progress (playlist_id, video_id)
  select p_playlist_id, v.id
  from public.playlist_videos v
  where v.playlist_id = p_playlist_id
    and v.youtube_id = any (p_youtube_ids);
end;
$$;

-- ---------- ROW LEVEL SECURITY ----------

-- Enable RLS on every table. The app talks to the DB with the
-- service_role key (server-side only), which bypasses RLS.
-- No policies are granted, so anonymous users / the anon key
-- can never read or write anything directly.
alter table public.users enable row level security;
alter table public.playlists enable row level security;
alter table public.playlist_videos enable row level security;
alter table public.progress enable row level security;

-- Revoke default privileges from anon/authenticated roles as extra hardening
revoke all on table public.users from anon, authenticated;
revoke all on table public.playlists from anon, authenticated;
revoke all on table public.playlist_videos from anon, authenticated;
revoke all on table public.progress from anon, authenticated;

