# Copy this file to .env.local and fill in your own values:
#   cp .env.example .env.local

# ---- Supabase (https://supabase.com) ----
# Project Settings -> API -> Project URL
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Project Settings -> API -> anon public key
SUPABASE_ANON_KEY=your-anon-public-key

# Project Settings -> API -> service_role key (server-only, NEVER expose in client code)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Auth ----
# Secret used to sign/verify the app's own JWT tokens. Use any long random string,
# e.g. `openssl rand -base64 32` — keep it secret, never commit it.
JWT_SECRET=change-me-to-a-long-random-string

# ---- Rate limiting (existing feature) ----
# Set to "true" to enable per-IP rate limiting (1 playlist fetch / hour)
# Set to "false" to disable rate limiting entirely
RATE_LIMITING=true

# Optional: how long JWT tokens stay valid, e.g. 7d, 1h
JWT_EXPIRES_IN=7d